# Optional. If absent, the radar uses TickFlow's free endpoint for daily bars,
# instruments, exchanges, and universes.
TICKFLOW_API_KEY=
TUSHARE_TOKEN=
FEISHU_WEBHOOK_URL=

# Public Vercel dashboard URL. When set, the Feishu card ends with an
# "打开完整作战台" button that opens this page.
DASHBOARD_PUBLIC_URL=

# Optional durable history. The recommended setup uses a publishable key plus a
# random ingest key whose RLS policies only permit access to the radar tables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
RADAR_INGEST_KEY=
RADAR_STORAGE_BACKEND=auto

# Optional overrides.
TICKFLOW_BASE_URL=
MAINLINE_RADAR_MODE=curated
MAINLINE_MAX_SYMBOLS=0
